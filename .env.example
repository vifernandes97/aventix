# .env.example
NODE_ENV=development
TZ=America/Sao_Paulo

# App
DATABASE_URL=postgresql://aventix:aventix@localhost:5432/aventix

# Postgres (consumido pelo docker-compose.dev.yml)
POSTGRES_USER=aventix
POSTGRES_PASSWORD=aventix
POSTGRES_DB=aventix

# ---------------------------------------------------------------------------
# Admin (CLAUDE.md secao 13) — login unico do dono. Consumido SO por lib/auth.ts.
#
# Os tres valores abaixo sao PLACEHOLDERS. Sem eles o servidor sobe, avisa no
# log e recusa qualquer login; nenhuma tela de admin funciona.
# ---------------------------------------------------------------------------

# E-mail que entra no formulario de login.
ADMIN_EMAIL=troque-me@exemplo.com.br

# Hash bcrypt da senha (custo 12). NUNCA a senha em texto — nem aqui, nem no
# .env de verdade, nem no repo. Gere o seu com:
#
#     npm run auth:hash -- "sua-senha"
#
# >>> OS CIFROES DO HASH VAO ESCAPADOS COM \. NAO E ENFEITE. <<<
# O carregador de ambiente do Next (@next/env) expande variaveis no .env, e o
# hash bcrypt tem TRES cifroes ($2b$12$...). Sem escapar, `$2b$12$Abc` e lido
# como variavel inexistente e SOME: o valor chega com 50 caracteres em vez de
# 60, e todo login falha com aparencia de "senha errada".
#
# MEDIDO neste projeto, nas cinco formas possiveis:
#   $2b$12$...       -> 50 chars, QUEBRA
#   '$2b$12$...'     -> 50 chars, QUEBRA  (aspas simples NAO protegem)
#   "$2b$12$..."     -> 50 chars, QUEBRA  (aspas duplas NAO protegem)
#   \$2b\$12\$...    -> 60 chars, OK      <- use esta
#   '\$2b\$12\$...'  -> 60 chars, OK
#
# Cuidado extra: o `dotenv` puro (usado por scripts/seed.ts e pelos testes) le
# certo mesmo SEM escape, entao o erro nao aparece em script — so dentro do Next.
# `npm run auth:hash` ja imprime a linha pronta, escapada.
#
# O valor abaixo e um hash de exemplo, INUTILIZAVEL: nao corresponde a nenhuma
# senha conhecida e existe so para documentar o formato esperado.
ADMIN_PASSWORD_HASH=\$2b\$12\$SUBSTITUA.ESTE.VALOR.PELO.HASH.QUE.O.SCRIPT.GERAR00

# Segredo que cifra e assina o cookie de sessao (iron-session). Minimo 32
# caracteres; o servidor recusa menos que isso. Gere um com:
#
#     openssl rand -base64 48
#
# Trocar este valor invalida todas as sessoes abertas — util para expulsar uma
# sessao, ja que o MVP nao tem revogacao (sessao vive no cookie, nao no banco).
SESSION_SECRET=troque-me-por-no-minimo-32-caracteres-aleatorios

# -- pagamento (Asaas, CLAUDE.md secoes 2 e 18) -------------------------------
#
# A chave de API do Asaas COMECA COM CIFRAO ($aact_...), entao ela cai na MESMA
# armadilha do hash bcrypt acima — e foi MEDIDO neste projeto:
#
#   ASAAS_API_KEY='$aact_...'   -> chega VAZIA dentro do Next  (aspas nao protegem)
#   ASAAS_API_KEY=\$aact_...    -> chega inteira, OK           <- use esta
#   ASAAS_API_KEY='\$aact_...'  -> chega inteira, OK
#
# O sintoma sem escape e o boot avisando "ASAAS_API_KEY ausente" (a variavel
# inteira some), ou — se o cifrao estiver no meio — um 401 do Asaas, que manda
# olhar o painel em vez de olhar o .env. O boot valida prefixo e comprimento e
# aponta esta causa. No Easypanel, que injeta env em runtime, vale a MESMA regra.
#
# Sandbox e producao tem chaves DIFERENTES. A de producao so e gerada na Fase 4
# e entra como variavel de ambiente no Easypanel, nunca em arquivo (secao 18).
ASAAS_API_KEY='\$aact_SUBSTITUA_PELA_CHAVE_DO_PAINEL_DO_ASAAS'

# Sandbox: https://sandbox.asaas.com/api/v3
# Producao: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Token SECRETO do webhook, gerado por voce e colado no painel do Asaas ao
# cadastrar a URL. NAO e a API key: esta chave AUTORIZA A COBRAR na conta do
# tenant, enquanto o token abaixo so prova que quem bateu na porta e o Asaas.
# Sem ele configurado o webhook recusa TUDO com 401 (lado seguro) e nenhum
# pagamento confirma por essa via — a reconciliacao segura o fluxo ate arrumar.
ASAAS_WEBHOOK_TOKEN=gere-um-token-aleatorio-e-cole-o-mesmo-no-painel-do-asaas
